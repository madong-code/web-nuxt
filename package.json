{
    "name": "element-plus-nuxt-starter",
    "type": "module",
    "private": true,
    "packageManager": "pnpm@10.14.0",
    "version": "0.1.0",
    "description": "Element Plus with Nuxt 3 Minimal Starter",
    "repository": {
        "type": "git",
        "url": "https://github.com/element-plus/element-plus-nuxt-starter"
    },
    "author": "Element Plus Team",
    "license": "MIT",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev": "nuxi dev",
        "dev:frontend": "cross-env NUXT_PUBLIC_ROUTING_MODE=frontend nuxi dev",
        "dev:backend": "cross-env NUXT_PUBLIC_ROUTING_MODE=backend nuxi dev",
        "build": "nuxi build",
        "build:frontend": "cross-env NUXT_PUBLIC_ROUTING_MODE=frontend nuxi build",
        "build:backend": "cross-env NUXT_PUBLIC_ROUTING_MODE=backend nuxi build",
        "build:integrated": "cross-env BUILD_TARGET=integrated nuxi build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "preview": "nuxi preview",
        "start": "node .output/server/index.mjs",
        "generate": "nuxi generate",
        "prepare": "nuxi prepare",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.1",
        "@iconify/vue": "^5.0.0",
        "@wangeditor/editor": "^5.1.23",
        "element-plus": "^2.10.5",
        "font-awesome": "4.7.0",
        "lodash-es": "4.17.21",
        "magicast": "0.3.5",
        "md-editor-v3": "^5.1.1",
        "nprogress": "0.2.0",
        "nuxt-icons": "^4.0.0",
        "pinia-plugin-persistedstate": "^4.7.1",
        "qrcode": "^1.5.4",
        "qs": "^6.14.1",
        "vue-i18n": "^11.2.8",
        "axios": "^1.6.0",
        "dayjs": "^1.11.13"
    },
    "devDependencies": {
        "@element-plus/nuxt": "^1.1.4",
        "@iconify-json/ri": "^1.2.5",
        "@nuxt/eslint": "^1.7.1",
        "@nuxtjs/color-mode": "^3.5.2",
        "@oxc-minify/binding-win32-x64-msvc": "^0.111.0",
        "@oxc-parser/binding-win32-x64-msvc": "^0.111.0",
        "@oxc-transform/binding-win32-x64-msvc": "^0.111.0",
        "@pinia/nuxt": "^0.11.2",
        "@types/nprogress": "0.2.3",
        "@types/qrcode": "^1.5.6",
        "@types/qs": "^6.14.0",
        "@unocss/nuxt": "^66.4.0",
        "@vueuse/nuxt": "^13.6.0",
        "consola": "^3.4.2",
        "cross-env": "^7.0.3",
        "eslint": "^9.32.0",
        "nuxt": "^4.2.0",
        "pinia": "^2.1.6",
        "sass": "^1.89.2",
        "typescript": "^5.9.2",
        "vite-tsconfig-paths": "^6.0.4",
        "vue-tsc": "^3.0.5",
        "axios": "^1.6.0"
    },
    "pnpm": {
        "peerDependencyRules": {
            "ignoreMissing": [
                "webpack",
                "vite",
                "vue"
            ]
        }
    }
}
