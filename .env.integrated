# 应用基础路径（资源/路由前缀）
NUXT_APP_BASE_URL=/web

# API 基础路径（生产环境请修改为实际地址）
NUXT_PUBLIC_API_BASE_URL=/api

# 请求头配置
NUXT_PUBLIC_REQUEST_HEADER_CHANNEL_KEY=pc
NUXT_PUBLIC_REQUEST_HEADER_TOKEN_KEY=Authorization

# 默认语言
NUXT_PUBLIC_DEFAULT_LANG=zh-CN

# 默认租户 ID（可选，空则表示不自动注入 X-Tenant-Id）
NUXT_PUBLIC_X_TENANT_ID=

# 路由菜单模式（开发期默认前端模式，便于本地联调前端骨架菜单）
# 可选值：frontend | backend | hybrid
# frontend — 前端 routes 声明式生成菜单骨架，后端可裁剪可见性
# backend  — 后端接口完全下发菜单
# hybrid   — 后端菜单为主骨架 + 前端路由补充合并
NUXT_PUBLIC_ROUTING_MODE=backend
